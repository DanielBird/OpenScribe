{
  "name": "describe",
  "private": true,
  "version": "1.1.0",
  "description": "Single-file transcription tool: speaker-labelled transcripts via ElevenLabs, optional English translation, .docx export.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/postbuild.mjs",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=verbose",
    "verify:single-file": "node scripts/verify-single-file.mjs",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:perf": "npm run build && node scripts/make-large-fixture.mjs && playwright test --project=perf --workers=1",
    "notices": "node scripts/make-notices.mjs",
    "release": "node scripts/release.mjs",
    "build:desktop": "vue-tsc -b && vite build --mode desktop",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:pack": "node scripts/pack-desktop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.1",
    "docx": "^9.11.0",
    "idb-keyval": "^6.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
