<?xml version="1.0" encoding="utf-8"?>

<!-- Phase 33 spike: a test identity for the STT probe (D7), beside DeScribe, never published. The Publisher is the
     app's, so the development certificate the app uses (devcert.pfx) signs it too. pack.ps1 writes the version in. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="DeScribe.SttProbe"
    Publisher="CN=91C9FF05-C619-4D52-8155-375ADA47D090"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeScribe STT probe</DisplayName>
    <PublisherDisplayName>Dtype</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="SttProbe" Executable="describe-stt-probe.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeScribe STT probe"
        Description="Phase 33 spike: test only"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="describe-stt-probe.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
