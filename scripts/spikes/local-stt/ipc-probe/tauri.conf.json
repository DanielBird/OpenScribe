{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeScribe STT probe",
  "version": "0.1.0",
  "identifier": "io.github.danielbird.describe.sttprobe",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeScribe STT probe (Phase 33)",
        "width": 900,
        "height": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../../src-tauri/icons/icon.ico"]
  }
}
