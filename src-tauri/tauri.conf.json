{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeScribe",
  "version": "../package.json",
  "identifier": "io.github.danielbird.describe",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "DeScribe",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true,
        "theme": "Light",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.elevenlabs.io https://api.anthropic.com https://generativelanguage.googleapis.com; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
